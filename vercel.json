{
  "buildCommand": "cd site && npm ci && npm run build",
  "outputDirectory": "site/build",
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "(www\\.)?delusjournal\\.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
